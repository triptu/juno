{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "react/no-unknown-property": "off",
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/out/**",
    "**/dist/**",
    "**/release/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "docs/**"
  ]
}
