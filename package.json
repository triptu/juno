{
  "name": "juno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Juno, a topic-first desktop Slack client",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @juno/desktop dev",
    "build": "pnpm --filter @juno/desktop build",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "oxlint . && node scripts/check-no-pointer-cursor.mjs && node scripts/check-deps.mjs && node scripts/check-fixtures-redacted.mjs",
    "check-deps": "node scripts/check-deps.mjs",
    "health": "node scripts/health.mjs",
    "health:knip": "knip --config knip.config.mjs --no-exit-code",
    "health:clones": "jscpd --config .jscpd.json --workers 2 --absolute packages/*/src apps/*/src",
    "health:size": "node scripts/health-size.mjs",
    "test": "node scripts/heavy.mjs pnpm -r --workspace-concurrency=2 --if-present test",
    "test:e2e": "node scripts/heavy.mjs sh -c \"pnpm --filter @juno/desktop test:e2e && pnpm --filter @juno/gallery test:e2e\"",
    "test:desktop": "node scripts/heavy.mjs pnpm --filter @juno/desktop test:e2e",
    "perf": "node scripts/heavy.mjs --exclusive pnpm --filter @juno/desktop perf",
    "test:feel": "node scripts/heavy.mjs --exclusive pnpm --filter @juno/desktop test:feel",
    "test:gallery": "node scripts/heavy.mjs pnpm --filter @juno/gallery test:e2e",
    "package": "pnpm --filter @juno/desktop package",
    "gallery": "pnpm --filter @juno/gallery dev",
    "gallery:shots": "node scripts/heavy.mjs pnpm --filter @juno/gallery shots",
    "smoke:live": "node scripts/smoke-live.ts",
    "probe:live": "node scripts/probe-live.ts",
    "sync:live": "node --import ./scripts/ts-resolve-hooks.mjs scripts/sync-live-dry-run.ts",
    "ai:eval": "pnpm --filter @juno/ai eval",
    "agent:eval": "pnpm --filter @juno/agent exec node --import ../../scripts/ts-resolve-hooks.mjs eval/run.ts",
    "remote": "node scripts/remote.mjs",
    "affected": "node scripts/affected.mjs",
    "verify:main": "node scripts/verify-main.mjs",
    "specs:check": "node scripts/heavy.mjs node specs/check.mjs",
    "specs:traces": "node scripts/heavy.mjs node specs/check.mjs --traces",
    "test:agent-contracts": "node scripts/heavy.mjs pnpm --filter @juno/agent-cards --filter @juno/agent-contract test",
    "test:agent-testing": "node scripts/heavy.mjs pnpm --filter @juno/agent-testing test",
    "test:agent": "node scripts/heavy.mjs pnpm --filter @juno/agent test",
    "test:notifications": "node scripts/heavy.mjs pnpm --filter @juno/engine test",
    "flake": "node scripts/flake.mjs"
  },
  "devDependencies": {
    "@informalsystems/quint": "0.33.0",
    "@juno/engine": "workspace:*",
    "@juno/fake-slack": "workspace:*",
    "@juno/slack": "workspace:*",
    "@juno/slack-schema": "workspace:*",
    "@juno/store": "workspace:*",
    "@juno/sync": "workspace:*",
    "@types/node": "24.19.2",
    "effect": "4.0.3",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3"
  }
}
