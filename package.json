{
  "name": "juno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Juno, a topic-first desktop Slack client",
  "packageManager": "bun@1.4.4-canary.20261023.1+5c6d4e24c",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "bun scripts/check-bun.mjs",
    "dev": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "typecheck": "bun scripts/typecheck-bun.mjs",
    "typecheck:tsc": "bun scripts/typecheck.mjs",
    "typecheck:parity": "bun scripts/heavy.mjs --queue typecheck --exclusive bun scripts/typecheck-bun.mjs --parity",
    "typecheck:bun": "bun scripts/typecheck-bun.mjs",
    "lint": "bun scripts/lint.mjs",
    "check-deps": "bun scripts/check-deps.mjs",
    "health": "bun scripts/health.mjs",
    "health:knip": "knip --config knip.config.mjs --no-exit-code",
    "health:clones": "jscpd --config .jscpd.json --workers 2 --absolute packages/*/src apps/*/src",
    "health:size": "bun scripts/health-size.mjs",
    "bench:sync": "bun scripts/heavy.mjs node --import ./scripts/ts-resolve-hooks.mjs scripts/sync-live-dry-run.ts --fake --large --paced --seconds 3600",
    "bench:engine": "bun scripts/heavy.mjs --exclusive sh -c \"cd packages/engine && bun test ./test/perf/*-large.perf.ts\"",
    "test": "bun scripts/heavy.mjs bun scripts/unit.mjs",
    "test:e2e": "bun scripts/heavy.mjs --electron sh -c \"bun run --cwd apps/desktop test:e2e && bun run --cwd apps/gallery test:e2e\"",
    "test:desktop": "bun scripts/heavy.mjs --electron bun run --cwd apps/desktop test:e2e",
    "test:browser": "bun scripts/heavy.mjs bun run --cwd apps/desktop test:browser",
    "test:dom": "bun scripts/heavy.mjs bun scripts/dom-tests.mjs",
    "test:electron": "bun scripts/heavy.mjs --electron bun run --cwd apps/desktop test:electron",
    "perf": "bun scripts/heavy.mjs --exclusive bun scripts/perf.mjs",
    "test:feel": "bun scripts/heavy.mjs --exclusive bun run --cwd apps/desktop test:feel",
    "test:gallery": "bun scripts/heavy.mjs --electron bun run --cwd apps/gallery test:e2e",
    "test:nightly": "bun scripts/heavy.mjs --electron bun scripts/nightly-tests.mjs",
    "test:plan": "bun scripts/plan.mjs",
    "package": "bun scripts/heavy.mjs --exclusive --priority release bun scripts/package.mjs",
    "release:version": "bun scripts/release-version.ts",
    "release": "bun scripts/release.mjs",
    "release:publish": "bun scripts/release-publish.ts",
    "gallery": "bun run --cwd apps/gallery dev",
    "web": "node --max-old-space-size=384 --import ./scripts/ts-resolve-hooks.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/desktop/web/host/cli.ts",
    "gallery:shots": "bun scripts/heavy.mjs --electron bun run --cwd apps/gallery shots",
    "smoke:live": "bun scripts/smoke-live.ts",
    "presence:live": "bun scripts/presence-live.ts",
    "presence:sub-live": "bun scripts/presence-sub-live.ts",
    "probe:live": "bun scripts/probe-live.ts",
    "react:live": "node --import ./scripts/ts-resolve-hooks.mjs scripts/react-live.ts",
    "forward:live": "bun scripts/forward-live.ts",
    "broadcast:live": "bun scripts/broadcast-live.ts",
    "huddle:live": "bun scripts/huddle-live.ts",
    "sync:timeline": "node --import ./scripts/ts-resolve-hooks.mjs scripts/first-sync-live.ts",
    "sync:live": "node --import ./scripts/ts-resolve-hooks.mjs scripts/sync-live-dry-run.ts",
    "ai:eval": "bun run --cwd packages/ai eval",
    "notif:replay": "node --import ./scripts/ts-resolve-hooks.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/notif-replay/cli.ts",
    "agent:eval": "cd packages/agent && bun eval/run.ts",
    "remote": "bun scripts/remote.mjs",
    "runner:check": "bun scripts/remote/runner.mjs",
    "remote:usage": "bun scripts/remote/usage.mjs",
    "affected": "bun scripts/affected.mjs",
    "verify:main": "bun scripts/verify-main.mjs",
    "specs:check": "bun scripts/heavy.mjs bun specs/check.mjs",
    "specs:traces": "bun scripts/heavy.mjs bun specs/check.mjs --traces",
    "specs:conformance": "bun scripts/heavy.mjs bun specs/conformance.mjs",
    "test:agent-contracts": "bun scripts/heavy.mjs sh -c \"bun run --cwd packages/agent-cards test && bun run --cwd packages/agent-contract test\"",
    "test:agent-testing": "bun scripts/heavy.mjs bun run --cwd packages/agent-testing test",
    "test:agent": "bun scripts/heavy.mjs bun run --cwd packages/agent test",
    "test:notifications": "bun scripts/heavy.mjs bun run --cwd packages/engine test",
    "flake": "bun scripts/flake.mjs",
    "test:package": "env JUNO_E2E_AI_JOBS=1 bun scripts/heavy.mjs --exclusive --priority release bun run --cwd apps/desktop test:package",
    "health:baseline": "bun scripts/health.mjs --update-baseline",
    "test:health": "bun test --timeout=30000 scripts/health.test.mjs",
    "test:repo-tools": "bun test --timeout=30000 scripts/build-cached.test.mjs scripts/build-inputs.test.mjs scripts/batch-merge.test.mjs scripts/check-migration-order.test.mjs scripts/affected-select.test.mjs scripts/heavy.test.mjs scripts/release-gate.test.mjs scripts/release.test.mjs scripts/verify-main.test.mjs scripts/test-results-reporter.test.mjs scripts/check-tokens.test.mjs scripts/affected.test.mjs scripts/nightly-reach.test.mjs",
    "test:runner": "bun test --timeout=30000 scripts/remote/runner.test.mjs scripts/remote/workspace.test.mjs scripts/remote/runner-health.test.mjs scripts/plan.test.mjs",
    "pictures:build": "bun scripts/pictures/build.mjs",
    "pictures:upload": "bun scripts/pictures/upload.mjs"
  },
  "devDependencies": {
    "@informalsystems/quint": "0.33.0",
    "@juno/ai": "workspace:*",
    "@juno/domain": "workspace:*",
    "@juno/engine": "workspace:*",
    "@juno/fake-slack": "workspace:*",
    "@juno/huddle-media": "workspace:*",
    "@juno/notifications": "workspace:*",
    "@juno/richtext": "workspace:*",
    "@juno/slack": "workspace:*",
    "@juno/slack-schema": "workspace:*",
    "@juno/state": "workspace:*",
    "@juno/store": "workspace:*",
    "@juno/sync": "workspace:*",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "effect": "4.0.3",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "docs/juno-agent/spikes"
  ],
  "packageExtensions": {
    "@informalsystems/quint": {
      "dependencies": {
        "protobufjs": "7.6.6",
        "semver": "7.7.4"
      }
    },
    "@phosphor-icons/react": {
      "peerDependencies": {
        "@types/react": "*"
      },
      "peerDependenciesMeta": {
        "@types/react": {
          "optional": true
        }
      }
    },
    "playwright-core": {
      "peerDependencies": {
        "electron": "*"
      },
      "peerDependenciesMeta": {
        "electron": {
          "optional": true
        }
      }
    }
  },
  "trustedDependencies": []
}
