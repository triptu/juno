{
  "name": "@juno/gallery",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only gallery that renders every ui and views fixture for review and screenshots.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.shots.json",
    "shots": "node ../../scripts/build-cached.mjs dist vite build && playwright test --project shots",
    "test:e2e": "node ../../scripts/build-cached.mjs dist vite build && playwright test --project behaviour"
  },
  "dependencies": {
    "@juno/tokens": "workspace:*",
    "@juno/ui": "workspace:*",
    "@juno/views": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@juno/testing": "workspace:*",
    "@playwright/test": "1.64.0",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "5.9.3",
    "unplugin": "2.3.11",
    "vite": "7.3.7"
  },
  "juno": {
    "allowedDeps": [
      "@juno/tokens",
      "@juno/ui",
      "@juno/views"
    ],
    "testDeps": [
      "@juno/testing"
    ]
  }
}
