{
  "name": "@juno/desktop",
  "productName": "Juno",
  "version": "0.1.0",
  "private": true,
  "description": "Juno desktop app (Electron shell).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/without-run-as-node.mjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node ../../scripts/without-run-as-node.mjs electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test:e2e": "pnpm build && node ../../scripts/without-run-as-node.mjs playwright test",
    "package": "pnpm build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@juno/contract": "workspace:*",
    "@juno/tokens": "workspace:*",
    "@juno/ui": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "effect": "4.0.3",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "unplugin": "2.3.11",
    "vite": "7.3.7"
  },
  "juno": {
    "allowedDeps": [
      "@juno/contract",
      "@juno/engine",
      "@juno/state",
      "@juno/tokens",
      "@juno/views"
    ],
    "exceptions": [
      "@juno/ui"
    ]
  }
}
