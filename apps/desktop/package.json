{
  "name": "@juno/desktop",
  "productName": "Juno",
  "version": "0.1.0",
  "private": true,
  "description": "Juno desktop app (Electron shell).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/without-run-as-node.mjs electron-vite dev",
    "build": "electron-vite build && node ../../scripts/check-bundle-size.mjs",
    "start": "node ../../scripts/without-run-as-node.mjs electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test:e2e": "pnpm build && node ../../scripts/without-run-as-node.mjs playwright test",
    "perf": "pnpm build && JUNO_PERF=1 node ../../scripts/without-run-as-node.mjs playwright test e2e/perf.spec.ts",
    "package": "pnpm build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@juno/agent": "workspace:*",
    "@juno/agent-contract": "workspace:*",
    "@juno/contract": "workspace:*",
    "@juno/engine": "workspace:*",
    "@juno/slack": "workspace:*",
    "@juno/state": "workspace:*",
    "@juno/tokens": "workspace:*",
    "@juno/views": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "effect": "4.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@juno/fake-slack": "workspace:*",
    "@juno/testing": "workspace:*",
    "@playwright/test": "1.64.0",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "unplugin": "2.3.11",
    "vite": "7.3.7"
  },
  "juno": {
    "allowedDeps": [
      "@juno/agent",
      "@juno/agent-contract",
      "@juno/agent-juno",
      "@juno/contract",
      "@juno/engine",
      "@juno/slack",
      "@juno/state",
      "@juno/tokens",
      "@juno/views"
    ],
    "testDeps": [
      "@juno/fake-slack",
      "@juno/testing"
    ]
  }
}
