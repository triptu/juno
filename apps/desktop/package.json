{
  "name": "@juno/desktop",
  "productName": "Juno",
  "version": "0.1.22",
  "private": true,
  "description": "Juno desktop app (Electron shell).",
  "main": "./out/main/index.js",
  "files": [
    "out",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "dev": "bun ../../scripts/without-run-as-node.mjs electron-vite dev",
    "build": "bun ../../scripts/build-desktop.mjs && bun ../../scripts/check-bundle-size.mjs",
    "build:web": "rm -rf dist && vite build -c vite.web.config.ts && bun web/build-host.mjs",
    "build:dom": "vite build -c dom/vite.config.ts && bun web/build-host.mjs dom/dist",
    "start": "bun ../../scripts/without-run-as-node.mjs electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json && tsc -p tsconfig.dom.json",
    "test": "bun test --randomize --timeout=30000",
    "test:e2e": "bun ../../scripts/without-run-as-node.mjs playwright test",
    "test:browser": "bun ../../scripts/without-run-as-node.mjs playwright test --project=browser --project=feel",
    "test:electron": "bun ../../scripts/without-run-as-node.mjs playwright test --project=electron",
    "perf": "JUNO_PERF=1 bun ../../scripts/without-run-as-node.mjs playwright test -c playwright.perf.config.ts",
    "test:feel": "bun ../../scripts/build-cached.mjs out bun run build && bun ../../scripts/without-run-as-node.mjs playwright test -c playwright.feel.config.ts",
    "package": "bun ../../scripts/package.mjs",
    "test:package": "bun ../../scripts/without-run-as-node.mjs playwright test -c playwright.package.config.ts"
  },
  "dependencies": {
    "electron-updater": "6.8.3",
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@electron/fuses": "1.8.0",
    "@juno/agent": "workspace:*",
    "@juno/agent-contract": "workspace:*",
    "@juno/agent-testing": "workspace:*",
    "@juno/contract": "workspace:*",
    "@juno/engine": "workspace:*",
    "@juno/fake-slack": "workspace:*",
    "@juno/highlight": "workspace:*",
    "@juno/huddle-media": "workspace:*",
    "@juno/huddle-views": "workspace:*",
    "@juno/pictures": "workspace:*",
    "@juno/slack": "workspace:*",
    "@juno/state": "workspace:*",
    "@juno/testing": "workspace:*",
    "@juno/tokens": "workspace:*",
    "@juno/views": "workspace:*",
    "@playwright/test": "1.64.0",
    "@stylexjs/unplugin": "0.19.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "1.4.3",
    "effect": "4.0.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "20.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "unplugin": "2.3.11",
    "vite": "7.3.7",
    "ws": "8.22.0"
  },
  "juno": {
    "allowedDeps": [
      "@juno/agent",
      "@juno/agent-contract",
      "@juno/agent-juno",
      "@juno/contract",
      "@juno/engine",
      "@juno/highlight",
      "@juno/huddle-media",
      "@juno/huddle-views",
      "@juno/slack",
      "@juno/state",
      "@juno/tokens",
      "@juno/views"
    ],
    "testDeps": [
      "@juno/agent-testing",
      "@juno/fake-slack",
      "@juno/pictures",
      "@juno/testing"
    ]
  }
}
