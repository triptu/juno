{
  "name": "@juno/views",
  "version": "0.1.0",
  "private": true,
  "description": "Juno's feature views. Dumb React components built from @juno/ui: props in, callbacks out. Every view ships fixtures for the gallery.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@juno/agent-contract": "workspace:*",
    "@juno/contract": "workspace:*",
    "@juno/tokens": "workspace:*",
    "@juno/ui": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@stylexjs/stylex": "0.19.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "5.9.3"
  },
  "juno": {
    "allowedDeps": [
      "@juno/agent-contract",
      "@juno/contract",
      "@juno/tokens",
      "@juno/ui"
    ]
  }
}
