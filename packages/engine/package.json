{
  "name": "@juno/engine",
  "version": "0.1.0",
  "private": true,
  "description": "The Juno engine: the app Layer, feature handlers and the port protocol server. A plain Node program; Electron hosts it in a utility process.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --randomize --timeout=30000"
  },
  "dependencies": {
    "@juno/agent-contract": "workspace:*",
    "@juno/agent-juno": "workspace:*",
    "@juno/ai": "workspace:*",
    "@juno/contract": "workspace:*",
    "@juno/domain": "workspace:*",
    "@juno/huddle": "workspace:*",
    "@juno/notifications": "workspace:*",
    "@juno/richtext": "workspace:*",
    "@juno/slack": "workspace:*",
    "@juno/store": "workspace:*",
    "@juno/sync": "workspace:*",
    "@juno/topic-art": "workspace:*",
    "effect": "4.0.3",
    "https-proxy-agent": "9.1.0"
  },
  "devDependencies": {
    "@juno/agent": "workspace:*",
    "@juno/agent-testing": "workspace:*",
    "@juno/fake-slack": "workspace:*",
    "@juno/state": "workspace:*",
    "@juno/testing": "workspace:*",
    "@types/node": "24.19.2",
    "bun-types": "1.4.3",
    "typescript": "7.0.2"
  },
  "juno": {
    "allowedDeps": [
      "@juno/agent-contract",
      "@juno/agent-juno",
      "@juno/ai",
      "@juno/contract",
      "@juno/domain",
      "@juno/richtext",
      "@juno/slack",
      "@juno/store",
      "@juno/sync",
      "@juno/topic-art",
      "@juno/notifications",
      "@juno/huddle"
    ],
    "testDeps": [
      "@juno/agent",
      "@juno/agent-testing",
      "@juno/fake-slack",
      "@juno/state",
      "@juno/testing"
    ]
  }
}
