{
  "name": "@juno/engine",
  "version": "0.1.0",
  "private": true,
  "description": "The Juno engine: the app Layer, feature handlers and the port protocol server. A plain Node program; Electron hosts it in a utility process.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@juno/agent-contract": "workspace:*",
    "@juno/agent-juno": "workspace:*",
    "@juno/ai": "workspace:*",
    "@juno/contract": "workspace:*",
    "@juno/domain": "workspace:*",
    "@juno/richtext": "workspace:*",
    "@juno/slack": "workspace:*",
    "@juno/store": "workspace:*",
    "@juno/sync": "workspace:*",
    "@juno/topic-art": "workspace:*",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@juno/fake-slack": "workspace:*",
    "@juno/state": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "juno": {
    "allowedDeps": [
      "@juno/agent-contract",
      "@juno/agent-juno",
      "@juno/ai",
      "@juno/contract",
      "@juno/domain",
      "@juno/richtext",
      "@juno/slack",
      "@juno/store",
      "@juno/sync",
      "@juno/topic-art"
    ],
    "testDeps": [
      "@juno/fake-slack",
      "@juno/state"
    ]
  }
}
