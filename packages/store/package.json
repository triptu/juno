{
  "name": "@juno/store",
  "version": "0.1.0",
  "private": true,
  "description": "The two SQLite databases per workspace (cache.db and user.db), their migrations, writer and reader clients, and keyed invalidation for live queries.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --randomize --timeout=5000"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "4.0.3",
    "@juno/domain": "workspace:*",
    "@juno/slack-schema": "workspace:*",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@juno/testing": "workspace:*",
    "@types/node": "24.19.2",
    "bun-types": "1.4.3",
    "typescript": "7.0.2"
  },
  "juno": {
    "allowedDeps": [
      "@juno/domain",
      "@juno/slack-schema"
    ],
    "testDeps": [
      "@juno/testing"
    ]
  }
}
