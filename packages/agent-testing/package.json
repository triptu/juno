{
  "name": "@juno/agent-testing",
  "version": "0.1.0",
  "private": true,
  "description": "Test doubles for Juno Agent: a scripted model, a compactor model, a fake OpenRouter over HTTP and a fake Codex binary, fake Notion, Littlebird and T3 MCP servers, hostile Slack fixtures and the crash harness. Imported only by tests.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./codex": "./src/codex/fakeCodex.ts",
    "./openrouter": "./src/model/openrouter.ts",
    "./openai": "./src/model/openai.ts",
    "./mcp": "./src/mcp/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@juno/agent": "workspace:*",
    "@juno/agent-contract": "workspace:*",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "@openai/codex-sdk": "0.162.1",
    "@juno/agent-memory": "workspace:*",
    "@types/bun": "1.4.2"
  },
  "juno": {
    "allowedDeps": [
      "@juno/agent",
      "@juno/agent-contract"
    ],
    "testDeps": [
      "@juno/agent-memory"
    ]
  }
}
