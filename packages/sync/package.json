{
  "name": "@juno/sync",
  "version": "0.1.0",
  "private": true,
  "description": "Slack to store: cold and warm boot, thread discovery, merge rules, socket event application, read-state seeding and reindexTopics. Runs inside the engine for the life of a session.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@juno/domain": "workspace:*",
    "@juno/slack": "workspace:*",
    "@juno/slack-schema": "workspace:*",
    "@juno/store": "workspace:*",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "juno": {
    "allowedDeps": [
      "@juno/domain",
      "@juno/slack",
      "@juno/slack-schema",
      "@juno/store"
    ]
  }
}
