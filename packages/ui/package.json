{
  "name": "@juno/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Juno's presentational primitives. Styled only with StyleX and @juno/tokens. No app state, no IPC, no product words.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@juno/tokens": "workspace:*",
    "@juno/topic-art": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@stylexjs/stylex": "0.19.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "juno": {
    "allowedDeps": [
      "@juno/tokens",
      "@juno/topic-art"
    ]
  }
}
