  },
  "dependencies": {
    "@juno/tokens": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "lucide-react": "1.55.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "5.9.3"
  },
  "juno": {
    "allowedDeps": [
      "@juno/tokens"
    ]
  }
}
