{
  "name": "@juno/richtext",
  "version": "0.1.0",
  "private": true,
  "description": "Pure text handling. Slack rich_text blocks and mrkdwn in, a renderer-agnostic MessageBody out; composer text in, outgoing rich_text out; preview lines and the emoji shortcode table.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --randomize --timeout=5000"
  },
  "dependencies": {
    "@juno/highlight": "workspace:*",
    "@juno/slack-schema": "workspace:*"
  },
  "devDependencies": {
    "effect": "4.0.3",
    "happy-dom": "20.0.10",
    "typescript": "7.0.2",
    "bun-types": "1.4.2"
  },
  "juno": {
    "allowedDeps": [
      "@juno/highlight",
      "@juno/slack-schema"
    ]
  }
}
