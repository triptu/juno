{
  "name": "@juno/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens for Juno as StyleX variables. The single source of colours, type, spacing, radii, shadows, sizes and motion.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./layout": "./src/layout.ts",
    "./tokens.stylex": "./src/tokens.stylex.ts",
    "./themes.stylex": "./src/themes.stylex.ts",
    "./global.css": "./src/global.css",
    "./fonts.css": "./src/fonts.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@stylexjs/stylex": "0.19.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "juno": {
    "allowedDeps": []
  }
}
