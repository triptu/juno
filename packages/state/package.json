{
  "name": "@juno/state",
  "version": "0.1.0",
  "private": true,
  "description": "The renderer's bridge to the engine: the port client and the atoms. The only package that imports effect/reactivity/Atom, effect/rpc, effect/workers and @effect/atom-react, and the client side of effect/socket.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./emoji": "./src/emoji.ts",
    "./agent": "./src/agent/index.ts",
    "./react": "./src/react.ts",
    "./transport": "./src/transport.ts",
    "./socket": "./src/socket.ts",
    "./perf": "./src/perf.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.3",
    "@juno/agent-contract": "workspace:*",
    "@juno/contract": "workspace:*",
    "@juno/pictures": "workspace:*",
    "effect": "4.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@juno/agent": "workspace:*",
    "@juno/agent-testing": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "7.0.2",
    "@types/bun": "1.4.2"
  },
  "juno": {
    "allowedDeps": [
      "@juno/agent-contract",
      "@juno/contract",
      "@juno/pictures"
    ],
    "testDeps": [
      "@juno/agent",
      "@juno/agent-testing"
    ]
  }
}
