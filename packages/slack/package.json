{
  "name": "@juno/slack",
  "version": "0.1.0",
  "private": true,
  "description": "The Slack client shared by the engine and the fake: Effect services for the HTTP API, the edge API and the socket. Payload schemas live in @juno/slack-schema.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./import": "./src/import/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --randomize --timeout=30000"
  },
  "dependencies": {
    "@juno/slack-schema": "workspace:*",
    "effect": "4.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@juno/fake-slack": "workspace:*",
    "@juno/testing": "workspace:*",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "bun-types": "1.4.3",
    "typescript": "7.0.2"
  },
  "juno": {
    "allowedDeps": [
      "@juno/slack-schema"
    ],
    "testDeps": [
      "@juno/fake-slack",
      "@juno/testing"
    ]
  }
}
