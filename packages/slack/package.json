{
  "name": "@juno/slack",
  "version": "0.1.0",
  "private": true,
  "description": "The Slack client shared by the engine and the fake: Effect services for the HTTP API, the edge API and the socket, plus the Effect Schemas for every payload Juno reads or sends.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "4.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@juno/fake-slack": "workspace:*",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
