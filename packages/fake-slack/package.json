{
  "name": "@juno/fake-slack",
  "version": "0.1.0",
  "private": true,
  "description": "A fake Slack: HTTP API, websocket, sign-in page, fixtures and a control API for tests. Speaks the protocol subset documented in docs/research/slack-data-access.md.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "start": "bun src/bin.ts"
  },
  "dependencies": {
    "@juno/slack-schema": "workspace:*",
    "effect": "4.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "bun-types": "1.4.3",
    "typescript": "7.0.2"
  },
  "juno": {
    "allowedDeps": [
      "@juno/slack-schema"
    ]
  }
}
