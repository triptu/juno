{
  "name": "@juno/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Pure rules. Ids, topics, status and visibility, titles, sorting, relative time, notification decisions, clarity and audience checks, the command grammar and context menu item lists. No I/O.",
