  },
  "dependencies": {
    "@juno/richtext": "workspace:*",
    "@juno/slack-schema": "workspace:*",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "bun-types": "1.4.2"
  },
  "juno": {
    "allowedDeps": [
      "@juno/richtext",
      "@juno/slack-schema"
    ]
  }
}
