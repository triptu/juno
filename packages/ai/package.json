{
  "name": "@juno/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Provider isolation. The AiProvider service with PiAiProvider (pi-ai, OpenRouter) and FakeAiProvider, and the task table (prompts, output schemas, tiers). Plain data in, plain data out. Never touches the store.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "node --import ../../scripts/ts-resolve-hooks.mjs eval/run.ts",
    "eval:title-privacy": "node --import ../../scripts/ts-resolve-hooks.mjs eval/title-privacy.ts",
    "bench": "node --import ../../scripts/ts-resolve-hooks.mjs eval/bench.ts",
    "grammar:bench": "node --import ../../scripts/ts-resolve-hooks.mjs eval/grammar-bench.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@juno/ai-failure": "workspace:*",
    "@juno/domain": "workspace:*",
    "@juno/topic-art": "workspace:*",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "juno": {
    "allowedDeps": [
      "@juno/ai-failure",
      "@juno/domain",
      "@juno/topic-art"
    ]
  }
}
