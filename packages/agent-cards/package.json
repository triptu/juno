{
  "name": "@juno/agent-cards",
  "version": "0.1.0",
  "private": true,
  "description": "Juno Agent's card catalogue: card kinds and their schemas, canonical payloads, digests, child-action expansion and card status machines. No UI, no I/O.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./presentation": "./src/presentation.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "fast-check": "4.3.0",
    "bun-types": "1.4.2"
  },
  "juno": {
    "allowedDeps": []
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --randomize --timeout=30000"
  },
  "dependencies": {
    "effect": "4.0.3",
    "@noble/hashes": "2.4.0",
    "typebox": "1.3.27"
  }
}
